 <TFMaxInterPgf  1.0 pt>
 <Notes 
  <FNote 
   <ID 24>
   <Para 
    <Unique 105373>
    <PgfTag `Footnote'>
    <ParaLine 
     <String `If necessary, you may place some address information in a '>
    >
    <ParaLine 
     <String `footnote, or in a nsmaed section at the end of your paper.'>
    >
   > # end of Para
  > # end of FNote
 > # end of Notes
 <Para 
  <Unique 105260>
  <PgfTag `1Heading'>
  <ParaLine 
   <TextRectID 17>
   <String `ABSTRACT'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105266>
  <PgfTag `Body'>
  <ParaLine 
   <String `In this paper, we describe the formatting requirements for '>
  > # end of ParaLine
  <ParaLine 
   <String `the CHI Conference and offer a number of suggestions on '>
  > # end of ParaLine
  <ParaLine 
   <String `writing style for the worldwide CHI readership.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105262>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Keywords'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105274>
  <PgfTag `Body'>
  <ParaLine 
   <String `Guides, instructions, author\qs kit, conference publications'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 104891>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `INTRODUCTION'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105285>
  <PgfTag `Body'>
  <ParaLine 
   <String `The CHI '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `Proceedings'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` and conference '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `Summary'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` are the '>
  > # end of ParaLine
  <ParaLine 
   <String `records of the conference. As in previous years, we hope to '>
  > # end of ParaLine
  <ParaLine 
   <String `give the books a single, high-quality appearance. To do this, '>
  > # end of ParaLine
  <ParaLine 
   <String `we ask that authors follow some simple guidelines. In '>
  > # end of ParaLine
  <ParaLine 
   <String `essence, we ask you to make your paper look exactly like '>
  > # end of ParaLine
  <ParaLine 
   <String `this document. The easiest way to do this is simply to '>
  > # end of ParaLine
  <ParaLine 
   <String `down-load a template from [2], and replace the content with '>
  > # end of ParaLine
  <ParaLine 
   <String `your own material.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105292>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `PAGE SIZE'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105293>
  <PgfTag `Body'>
  <ParaLine 
   <String `All material on each page should fit within a rectangle of 18 '>
  > # end of ParaLine
  <ParaLine 
   <String `x 23.5 cm (7" x 9.25"), centered on the page, beginning 1.9 '>
  > # end of ParaLine
  <ParaLine 
   <String `cm (.75") from the top of the page, with a .85 cm (.33") '>
  > # end of ParaLine
  <ParaLine 
   <String `space between two 8.4 cm (3.3") columns.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105294>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `TYPESET TEXT'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105295>
  <PgfTag `Body'>
  <ParaLine 
   <String `Prepare your submissions on a typesetter or word proces'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `sor.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105296>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Normal or Body Text'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105297>
  <PgfTag `Body'>
  <ParaLine 
   <String `Please use a 10-point Times Roman font, or other Roman '>
  > # end of ParaLine
  <ParaLine 
   <String `font with serifs, as close as possible in appearance to Times '>
  > # end of ParaLine
  <ParaLine 
   <String `Roman in which these guidelines have been set. The goal is '>
  > # end of ParaLine
  <ParaLine 
   <String `to have a 10-point text, as you see here. Please use sans-'>
  > # end of ParaLine
  <ParaLine 
   <String `serif or non-proportional fonts only for special purposes, '>
  > # end of ParaLine
  <ParaLine 
   <String `such as distinguishing source code text. The Press 10-point '>
  > # end of ParaLine
  <ParaLine 
   <String `font available to users of Script is a good substitute for '>
  > # end of ParaLine
  <ParaLine 
   <String `Times Roman. If Times Roman is not available, try the font '>
  > # end of ParaLine
  <ParaLine 
   <String `named Computer Modern Roman. On a Macintosh, use the '>
  > # end of ParaLine
  <ParaLine 
   <String `font named Times.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105303>
  <PgfTag `Body'>
  <ParaLine 
   <TextRectID 18>
   <String `If you do not have a laser printer, you may be able to '>
  > # end of ParaLine
  <ParaLine 
   <String `arrange for a business to print your document for you. If no '>
  > # end of ParaLine
  <ParaLine 
   <String `laser printer is available, then use the best alternative printer '>
  > # end of ParaLine
  <ParaLine 
   <String `you have. If you have no access to any printer, then your '>
  > # end of ParaLine
  <ParaLine 
   <String `material should be typewritten onto larger pages and '>
  > # end of ParaLine
  <ParaLine 
   <String `reduced 25%. Please ask the conference office for assis'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tance.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 104893>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Title and Authors'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105305>
  <PgfTag `Body'>
  <ParaLine 
   <String `The title (Helvetica 18-point bold), authors\q names (Times '>
  > # end of ParaLine
  <ParaLine 
   <String `Roman 12-point bold) and affiliations (Times Roman 12-'>
  > # end of ParaLine
  <ParaLine 
   <String `point) run across the full width of the page '>
   <Char EnDash>
   <String ` one column '>
  > # end of ParaLine
  <ParaLine 
   <String `17.8 cm (7") wide. We also recommend phone number and '>
  > # end of ParaLine
  <ParaLine 
   <String `e-mail address. See the top of this page for two names with '>
  > # end of ParaLine
  <ParaLine 
   <String `different addresses. If only one address is needed, center all '>
  > # end of ParaLine
  <ParaLine 
   <String `address text. For two addresses, use two centered tabs, and '>
  > # end of ParaLine
  <ParaLine 
   <String `so on. For more than three authors, you may have to impro'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `vise.'>
   <FNote 24>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105306>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Abstract and Keywords'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105307>
  <PgfTag `Body'>
  <ParaLine 
   <String `Every submission should begin with an abstract of about '>
  > # end of ParaLine
  <ParaLine 
   <String `100 words, followed by a set of keywords. The abstract and '>
  > # end of ParaLine
  <ParaLine 
   <String `keywords should be placed in the left column of the first '>
  > # end of ParaLine
  <ParaLine 
   <String `page under the left half of the title. The abstract should be a '>
  > # end of ParaLine
  <ParaLine 
   <String `concise statement of the problem, approach, findings, and '>
  > # end of ParaLine
  <ParaLine 
   <String `conclusions of the work described.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105308>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `First Page Copyright Notice'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105309>
  <PgfTag `Body'>
  <ParaLine 
   <String `Leave 2.5 cm (1") of '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `blank space'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` at the bottom of the left '>
  > # end of ParaLine
  <ParaLine 
   <String `column of the first page for the copyright notice.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105310>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Subsequent Pages'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105311>
  <PgfTag `Body'>
  <ParaLine 
   <String `For pages other than the first page, start at the top of the '>
  > # end of ParaLine
  <ParaLine 
   <String `page, and continue in double-column format. Right margins '>
  > # end of ParaLine
  <ParaLine 
   <String `should be justified, not ragged. The two columns on the last '>
  > # end of ParaLine
  <ParaLine 
   <String `page should be of equal length.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105312>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `References and Citations'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105313>
  <PgfTag `Body'>
  <ParaLine 
   <String `Use the standard '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `Communications of the ACM'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` format for '>
  > # end of ParaLine
  <ParaLine 
   <String `references '>
   <Char EnDash>
   <String ` that is, a numbered list at the end of the article, '>
  > # end of ParaLine
  <ParaLine 
   <String `ordered alphabetically by first author, and referenced by '>
  > # end of ParaLine
  <ParaLine 
   <String `numbers in brackets [1]. See the examples of citations at the '>
  > # end of ParaLine
  <ParaLine 
   <String `end of this document. Within this template file, use the style '>
  > # end of ParaLine
  <ParaLine 
   <String `named references for the text of your citation.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105314>
  <PgfTag `Body'>
  <ParaLine 
   <String `References should be published materials accessible to the '>
  > # end of ParaLine
  <ParaLine 
   <String `public. Internal technical reports may be cited '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `only if'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` they '>
  > # end of ParaLine
  <ParaLine 
   <String `are easily accessible (i.e. you can give the address to obtain '>
  > # end of ParaLine
  <ParaLine 
   <TextRectID 19>
   <String `the report within your citation) and may be obtained by any '>
  > # end of ParaLine
  <ParaLine 
   <String `reader. Proprietary information may '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `not'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` be cited. Private '>
  > # end of ParaLine
  <ParaLine 
   <String `communications should be acknowledged, not referenced  '>
  > # end of ParaLine
  <ParaLine 
   <String `(e.g., \xd2 [Robertson, personal communication]\xd3 ).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105315>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Page Numbering, Headers and Footers'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105316>
  <PgfTag `Body'>
  <ParaLine 
   <String `Do not include headers, footers or page numbers in your '>
  > # end of ParaLine
  <ParaLine 
   <String `submission. These will be added when the publications are '>
  > # end of ParaLine
  <ParaLine 
   <String `assembled.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105317>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `SECTIONS'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105318>
  <PgfTag `Body'>
  <ParaLine 
   <String `The heading of a section should be in Helvetica 9-point '>
  > # end of ParaLine
  <ParaLine 
   <String `bold in all-capitals. Sections should be unnumbered.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105319>
  <PgfTag `2Heading'>
  <ParaLine 
   <String `Subsections'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105320>
  <PgfTag `Body'>
  <ParaLine 
   <String `The heading of subsections should be in Helvetica 9-point '>
  > # end of ParaLine
  <ParaLine 
   <String `bold with only the initial letters capitalized. (Note: For sub-'>
  > # end of ParaLine
  <ParaLine 
   <String `sections and subsubsections, a word like '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `the'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` or '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `a'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` is not cap'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `italized unless it is the first word of the header'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105321>
  <PgfTag `3Heading'>
  <ParaLine 
   <String `Subsubsections'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105322>
  <PgfTag `Body'>
  <ParaLine 
   <String `The heading for subsubsections should be in Helvetica 9-'>
  > # end of ParaLine
  <ParaLine 
   <String `point italic with initial letters capitalized.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105323>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `FIGURES'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105324>
  <PgfTag `Body'>
  <ParaLine 
   <String `Figures should be inserted at the appropriate point in your '>
  > # end of ParaLine
  <ParaLine 
   <String `text. Figures may extend over the two columns up to 17.8 '>
  > # end of ParaLine
  <ParaLine 
   <String `cm (7") if necessary. Black and white photographs (not '>
  > # end of ParaLine
  <ParaLine 
   <String `Polaroid prints) may be mounted on the camera-ready '>
  > # end of ParaLine
  <ParaLine 
   <String `paper with glue or double-sided tape. A service bureau can '>
  > # end of ParaLine
  <ParaLine 
   <String `make a special print of your black and white photography '>
  > # end of ParaLine
  <ParaLine 
   <String `for printing purposes (optional). To avoid smudges, attach '>
  > # end of ParaLine
  <ParaLine 
   <String `figures by paste or tape applied to their '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `back'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` surfaces only. '>
  > # end of ParaLine
  <ParaLine 
   <String `Each figure should have a figure caption in Times Roman.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105325>
  <PgfTag `Body'>
  <ParaLine 
   <String `Color figures should appear on separate pages so that they '>
  > # end of ParaLine
  <ParaLine 
   <String `may be collected into a color section in the proceedings. '>
  > # end of ParaLine
  <ParaLine 
   <String `Color figures are a large expense for the conference. '>
  > # end of ParaLine
  <ParaLine 
   <String `Include them only if they are absolutely necessary '>
   <Char EnDash>
   <String ` and '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `only'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` if your submission category permits them.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105326>
  <PgfTag `1Heading'>
  <ParaLine 
   <String `LANGUAGE, STYLE AND CONTENT'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105327>
  <PgfTag `Body'>
  <ParaLine 
   <String `The written and spoken language of CHI is English. Spell'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ing and punctuation may consistently use any dialect of '>
  > # end of ParaLine
  <ParaLine 
   <String `English (e.g., British, Canadian or US). Hyphenation is '>
  > # end of ParaLine
  <ParaLine 
   <String `optional. Please write for an international audience:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105328>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Write in a straightforward style. Use simple sentence '>
  > # end of ParaLine
  <ParaLine 
   <String `structure. Try to avoid long sentences and complex sen'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tence structures. Use semicolons carefully.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105329>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Use common and basic vocabulary (e.g., use the word '>
  > # end of ParaLine
  <ParaLine 
   <String `\xd2 unusual\xd3  rather than the word \xd2 arcane\xd3 ).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105330>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <TextRectID 19>
   <Char Tab>
   <Char Tab>
   <String `Briefly define or explain all technical terms.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105331>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Explain all acronyms the first time they are used in your '>
  > # end of ParaLine
  <ParaLine 
   <String `text '>
   <Char EnDash>
   <String ` e.g., \xd2 World Wide Web (WWW)\xd3 .'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105332>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Explain local references (e.g., not everyone knows all '>
  > # end of ParaLine
  <ParaLine 
   <String `city names in a particular country).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105333>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Explain \xd2 insider\xd3  comments. Ensure that your whole '>
  > # end of ParaLine
  <ParaLine 
   <String `audience understands any reference whose meaning you '>
  > # end of ParaLine
  <ParaLine 
   <String `do not describe (e.g., do not assume that everyone has '>
  > # end of ParaLine
  <ParaLine 
   <String `used a Macintosh or a particular application).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105334>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Explain colloquial language and puns. Understanding '>
  > # end of ParaLine
  <ParaLine 
   <String `phrases like \xd2 red herring\xd3  requires a cultural knowledge '>
  > # end of ParaLine
  <ParaLine 
   <String `of English. Humor and irony are difficult to translate.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105335>
  <PgfTag `Bullet'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Use unambiguous forms for culturally localized con'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `cepts, such as times, dates, currencies and numbers '>
  > # end of ParaLine
  <ParaLine 
   <String `(e.g., \xd2 1-5- 97\xd3  or \xd2 5/1/97\xd3  may mean 5 January or 1 '>
  > # end of ParaLine
  <ParaLine 
   <String `May , and \xd2 seven o\qclock\xd3  may mean 7:00 am or 19:00).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 105336>
  <PgfTag `BulletLast'>
  <PgfNumString `\xa5 \x11 '>
  <ParaLine 
   <Char Tab>
   <Char Tab>
   <String `Be careful with the use of gender-specific pronouns ('>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `he'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `, '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `she'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `) and other gendered words ('>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `chairman'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `, '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `manpower'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `, '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `man-months'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `). Use inclusive language (e.g., '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <String `she or he'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `, '>
   <Font 
    <FTag `Emphasis'>
    <FLocked No>
   > # end of Font
   <Char DiscHyphen>
   <String `s/'>
  > # end of ParaLine
  <ParaLine 
